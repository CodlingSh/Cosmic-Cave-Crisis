void setup() {
  ab.begin();
  ab.setFrameRate(60);
  ab.initRandomSeed();

  lives = 3;
  level.resetLevel();
  
  Serial.begin(9600);
}

void loop() {
  if (!ab.nextFrame()) return;

  ab.pollButtons();
  ab.clear();

  switch(gameState) {
    case 0: // Title
      titleScreen();
      break;
    case 1: // Gameplay
      mainGameLoop();
      break;
    case 4:
      credits.draw();

      if (ab.justPressed(A_BUTTON) || ab.justPressed(B_BUTTON)) {
        gameState = 0;
      }
      break;
    case 7: // Game Over
      gameOver();
      break;
  }
  
  ab.display();
}

